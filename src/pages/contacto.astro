---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoTrinidad from '../assets/logo-trinidad.png';
// Página «Contacto»: WhatsApp, teléfono, horarios y mapa.
// Provisional: cambia la dirección, el teléfono y los horarios por los reales.
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Contacto | Concesionario Trinidad</title>
	</head>
	<body class="bg-blanco font-texto leading-relaxed text-gris antialiased">
		<header class="bg-rojo px-6 py-4">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<a href="/" class="font-titulo text-2xl font-semibold text-blanco">
					<Image
						src={logoTrinidad}
						alt="Logotipo de Concesionario Trinidad"
						width={160}
						class="mr-3 inline-block h-10 w-auto align-middle"
					/>
					Concesionario Trinidad
				</a>
				<nav aria-label="Principal">
					<ul class="flex flex-wrap gap-x-6 gap-y-2">
						<li><a href="/" class="text-blanco hover:text-rojo-claro">Inicio</a></li>
						<li><a href="/vehiculos" class="text-blanco hover:text-rojo-claro">Vehículos</a></li>
						<li><a href="/nosotros" class="text-blanco hover:text-rojo-claro">Nosotros</a></li>
						<li>
							<a href="/contacto" aria-current="page" class="font-semibold text-blanco underline">Contacto</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<main class="mx-auto max-w-3xl space-y-10 px-6 py-10">
			<section class="space-y-4">
				<h1 class="font-titulo text-4xl font-bold text-rojo">Contacto</h1>
				<p>
					¿Te interesa un vehículo o quieres visitarnos? Escríbenos por WhatsApp y te respondemos con
					fotos, precios y disponibilidad. También puedes llamarnos o venir directamente al showroom
					en Trinidad, Beni, en el horario de atención.
				</p>
				<p>
					<a
						href="https://wa.me/59170000000"
						class="inline-block rounded-full bg-rojo px-6 py-3 font-semibold text-blanco hover:bg-rojo-oscuro"
						>Escríbenos por WhatsApp</a
					>
				</p>
			</section>

			<section class="space-y-4">
				<h2 class="font-titulo text-2xl font-bold text-rojo">Horario de atención</h2>
				<table class="w-full border-collapse text-left">
					<caption class="mb-2 text-sm text-gris-medio">Horario de atención al público</caption>
					<thead>
						<tr>
							<th scope="col" class="border-b-2 border-rojo px-3 py-2 font-semibold text-rojo">Día</th>
							<th scope="col" class="border-b-2 border-rojo px-3 py-2 font-semibold text-rojo">Horario</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="border-b border-gris/20 px-3 py-2">Lunes a viernes</td>
							<td class="border-b border-gris/20 px-3 py-2">8:00 a 12:00 y 15:00 a 19:00</td>
						</tr>
						<tr>
							<td class="border-b border-gris/20 px-3 py-2">Sábado</td>
							<td class="border-b border-gris/20 px-3 py-2">8:00 a 13:00</td>
						</tr>
						<tr>
							<td class="border-b border-gris/20 px-3 py-2">Domingo</td>
							<td class="border-b border-gris/20 px-3 py-2">Cerrado</td>
						</tr>
					</tbody>
				</table>
			</section>

			<section class="space-y-4">
				<h2 class="font-titulo text-2xl font-bold text-rojo">Dónde estamos</h2>
				<p>Nos encontramos en la ciudad de Trinidad, departamento de Beni, Bolivia.</p>
				<address class="not-italic">
					Av. Principal, Trinidad, Beni, Bolivia<br />
					<a href="tel:+59170000000" class="font-semibold text-rojo hover:text-rojo-oscuro"
						>Llamar al 700 00000</a
					>
				</address>
				<iframe
					title="Mapa del Concesionario Trinidad en la ciudad de Trinidad, Beni"
					src="https://www.google.com/maps?q=Trinidad,+Beni,+Bolivia&output=embed"
					width="600"
					height="450"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					class="h-auto w-full rounded-2xl"></iframe>
			</section>
		</main>

		<footer class="mt-12 bg-gris-claro py-8 text-gris-medio">
			<div class="mx-auto max-w-3xl px-6">
				<address>
					Av. Principal, Trinidad, Beni, Bolivia<br />
					<a href="tel:+59170000000" class="font-semibold text-rojo hover:text-rojo-oscuro"
						>Llamar al 700 00000</a
					>
				</address>
			</div>
		</footer>
	</body>
</html>
